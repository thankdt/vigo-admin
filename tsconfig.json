{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Lưới bắt import/biến thừa. `npm run lint` KHÔNG dùng được (repo không cài eslint,
    // `next lint` rơi vào prompt cài đặt), nên nếu tắt cờ này thì không có cổng nào bắt
    // được code chết — đúng thứ sinh ra nhiều nhất khi bóc một màn ra khỏi màn khác.
    // KHÔNG bật `noUnusedParameters`: chữ ký callback/handler thường phải giữ đủ tham số.
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
