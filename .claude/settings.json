{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)",
      "Bash(git status)",
      "Bash(echo \"exit=$?\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(rm -rf .next)",
      "Bash(docker info *)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test:pages)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest run*)",
      "Bash(npm run release:prepare)",
      "Bash(./scripts/release-prod.sh prepare*)",
      "Bash(./scripts/release-prod.sh verify*)",
      "Bash(./scripts/release-prod.sh rollback-help)",
      "Edit(.claude/skills/**)"
    ],
    "deny": [
      "Bash(*release.sh*)",
      "Bash(*k8s-app.sh*)",
      "Bash(*CONFIRM_PHRASE*)",
      "Bash(*gh workflow run*)",
      "Bash(*kubectl*apply*)",
      "Bash(*kubectl*delete*)",
      "Bash(*kubectl*patch*)",
      "Bash(*kubectl*edit*)",
      "Bash(*kubectl*scale*)",
      "Bash(*kubectl*rollout*)",
      "Bash(*kubectl*create*)",
      "Bash(*kubectl*replace*)",
      "Bash(*kubectl* set *)",
      "Bash(*kubectl*drain*)",
      "Bash(*kubectl*cordon*)",
      "Bash(*kubectl*taint*)",
      "Bash(*kubectl* label *)",
      "Bash(*kubectl*annotate*)",
      "Bash(*kubectl*exec*)",
      "Bash(terraform *)",
      "Bash(*terraform apply*)",
      "Bash(*terraform destroy*)",
      "Bash(*terraform init*)",
      "Bash(*terraform plan*)",
      "Bash(*aws ecs*)",
      "Bash(*aws ecr*)",
      "Bash(*aws cloudfront*)",
      "Bash(*docker push*)",
      "Bash(pwsh *)",
      "Bash(*deploy.ps1*)",
      "Bash(*scripts/deploy*)",
      "Bash(*crane*)",
      "Bash(*npm run deploy:prod*)",
      "Bash(*release-prod.sh*ship*)",
      "Bash(*--first-ship*)",
      "Bash(*--allow-ref*)",
      "Bash(*wrangler*)",
      "Bash(*deploy-pages.ts*)",
      "Skill(aws-deploy)",
      "Skill(aws-deploy *)",
      "Read(**/task_def.json)",
      "Read(**/.env)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.tunnel)",
      "Read(**/cloudflare.env)",
      "Read(~/.kube/**)",
      "Read(~/.vigo-cutover/**)",
      "Read(~/.config/vigo/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.vigo-cutover/**)",
      "Edit(~/.config/vigo/**)"
    ],
    "ask": [
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(aws:*)",
      "Bash(ssh *)",
      "Bash(*kubectl*)",
      "Bash(*gh pr merge*)",
      "mcp__postgres-readonly__query"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "../vigo",
      "../vigo-driver",
      "../vigo-admin",
      "../vigo-backend"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh/",
        "~/.kube/",
        "~/.vigo-cutover/",
        "~/.config/vigo/"
      ]
    }
  },
  "model": "opusplan"
}
